<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Overlay permission: needed to draw the block screen on top of other apps (Phase 1). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Lets the onboarding flow launch the "ignore battery optimizations" system dialog directly. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      The app list picker needs to see every installed app, not just the subset visible
      under Android 11+ package-visibility filtering. Required for this app's core purpose;
      needs a Play Console declaration (Blocker/Parental-control category) at publish time.
    -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".DiscnctApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Discnct">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Discnct">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Stub service: registered now so the onboarding flow can send the user to
          Settings > Accessibility and detect whether it's enabled. Detection logic
          (finding blocked apps / reels) is wired up in Phase 1, not here.
        -->
        <service
            android:name=".service.DiscnctAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
