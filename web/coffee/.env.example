# Server-side only — never exposed to the browser. Both come from the Razorpay
# dashboard: Settings → API Keys → Generate Test Key (test keys start with rzp_test_).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...

# Optional: where the "back to Discnct" link on the success/cancel pages points.
# Defaults to the GitHub repo if unset.
NEXT_PUBLIC_LANDING_URL=https://github.com/harshalbhor-art/discnct
