# Server-side only — never exposed to the browser. Get it from
# https://dashboard.stripe.com/apikeys (test mode keys start with sk_test_).
STRIPE_SECRET_KEY=sk_test_...

# Optional: where the "back to Discnct" link on the success/cancel pages points.
# Defaults to the GitHub repo if unset.
NEXT_PUBLIC_LANDING_URL=https://github.com/harshalbhor-art/discnct
